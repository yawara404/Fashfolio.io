# Copy to backend/.env. Credentials stay in Python and are never sent to the browser.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=90
DANBOORU_LOGIN=
DANBOORU_API_KEY=
# Optional. Override only for a mirror or a local mock server.
DANBOORU_BASE_URL=https://danbooru.donmai.us
DANBOORU_TIMEOUT=8
# Pinterest API v5 OAuth token with pins:read. Searches the authenticated user's pins.
PINTEREST_ACCESS_TOKEN=

# Optional private Cloudflare R2 storage. Never put these in frontend/public config.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=fashfolio-io
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=fashfolio
# Anonymous demo upload ceiling per API process/day; not a billing guarantee.
R2_DAILY_UPLOAD_MB=128
