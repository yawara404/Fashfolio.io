# Copy to backend/.env. Credentials stay in Python and are never sent to the browser.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=90
DANBOORU_LOGIN=
DANBOORU_API_KEY=
# Optional. Override only for a mirror or a local mock server.
DANBOORU_BASE_URL=https://danbooru.donmai.us
DANBOORU_TIMEOUT=8
# Pinterest API v5 OAuth token with pins:read. Searches the authenticated user's pins.
PINTEREST_ACCESS_TOKEN=
